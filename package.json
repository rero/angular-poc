{
  "name": "angular-poc",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start_mock": "ng serve --configuration mock",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@ngrx/signals": "^21.1.1",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^1.0.1",
    "@openng/optimus-ui-tailwindcss": "^1.0.1",
    "@openng/optimus-ui-themes": "^1.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "marked": "^17.0.6",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@analogjs/vitest-angular": "^2.6.4",
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@vitest/coverage-v8": "^4.1.10",
    "baseline-browser-mapping": "^2.11.12",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.25",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
